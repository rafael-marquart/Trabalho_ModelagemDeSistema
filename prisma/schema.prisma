generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  CANDIDATE
  COMPANY
  RECRUITER
  ADMIN
}

enum InvitationStatus {
  PENDING
  REFUSED
  EXPIRED
  CANCELLED
  ACCEPTED
}

enum AccessibilityDeclarationStatus {
  NOT_INFORMED
  NO_NEEDS_DECLARED
  NEEDS_DECLARED
}

model User {
  id                String                @id @default(cuid())
  email             String                @unique
  cpf               String?               @unique
  fullName          String
  passwordHash      String
  role              UserRole
  isActive          Boolean               @default(true)
  pendingActivation Boolean               @default(false)
  failedLoginCount  Int                   @default(0)
  lastFailedLoginAt DateTime?
  lockedUntil       DateTime?
  passwordChangedAt DateTime              @default(now())
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  sessions          Session[]
  passwordResetTokens PasswordResetToken[]
  company           Company?              @relation("CompanyAccount")
  recruiterLinks    RecruiterLink[]       @relation("RecruiterLinks")
  invitationsSent   RecruiterInvitation[] @relation("InvitationsSent")
  invitationsTo     RecruiterInvitation[] @relation("InvitationsTo")
  auditEvents       AuditEvent[]          @relation("AuditActor")
  candidateProfile  CandidateProfile?

  @@index([role, isActive])
}

model CandidateProfile {
  id                              String                         @id @default(cuid())
  userId                          String                         @unique
  education                       Json                           @default("[]")
  skills                          Json                           @default("[]")
  languages                       Json                           @default("[]")
  professionalExperience          Json                           @default("[]")
  courses                         Json                           @default("[]")
  certifications                  Json                           @default("[]")
  professionalLinks               Json                           @default("[]")
  accessibilityDeclaration        AccessibilityDeclarationStatus @default(NOT_INFORMED)
  accessibilityNeeds              Json                           @default("[]")
  accessibilityNeedOptionCodes    Json                           @default("[]")
  essentialAccessibilityResources Json                           @default("[]")
  createdAt                       DateTime                       @default(now())
  updatedAt                       DateTime                       @updatedAt
  user                            User                           @relation(fields: [userId], references: [id], onDelete: Restrict)
  documents                       CandidateProfileDocument[]

  @@index([updatedAt])
}

model CandidateProfileDocument {
  id                String          @id @default(cuid())
  candidateProfileId String
  category          CandidateDocumentCategory
  displayName       String
  originalName      String
  storedName        String          @unique
  mimeType          String
  sizeBytes         Int
  createdAt         DateTime        @default(now())
  candidateProfile  CandidateProfile @relation(fields: [candidateProfileId], references: [id], onDelete: Cascade)

  @@index([candidateProfileId, category, createdAt])
}

enum CandidateDocumentCategory {
  COURSE
  CERTIFICATION
}

enum AccessibilityNeedGroup {
  ARCHITECTURAL
  COMMUNICATION
  TECHNOLOGICAL
}

model AccessibilityNeedOption {
  code        String                @id
  name        String
  description String
  group       AccessibilityNeedGroup
  isMandatory Boolean               @default(false)
  isActive    Boolean               @default(true)
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt

  @@index([group, isActive])
  @@index([isMandatory, isActive])
}

model Company {
  id               String                @id @default(cuid())
  legalName        String
  tradeName        String?
  officialId       String?               @unique
  contactEmail     String
  emailConfirmedAt DateTime?
  accountUserId    String                @unique
  accountUser      User                  @relation("CompanyAccount", fields: [accountUserId], references: [id], onDelete: Restrict)
  recruiterLinks   RecruiterLink[]
  invitations      RecruiterInvitation[]
  emailVerificationTokens CompanyEmailVerificationToken[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
}

model RecruiterLink {
  id          String   @id @default(cuid())
  companyId   String
  recruiterId String
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  endedAt     DateTime?
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recruiter   User     @relation("RecruiterLinks", fields: [recruiterId], references: [id], onDelete: Restrict)

  @@index([companyId, active])
  @@index([recruiterId, active])
}

model RecruiterInvitation {
  id              String           @id @default(cuid())
  companyId       String
  recipientUserId String?
  recipientName   String
  recipientEmail  String
  sentByUserId    String?
  tokenHash       String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  respondedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  company         Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recipient       User?            @relation("InvitationsTo", fields: [recipientUserId], references: [id], onDelete: Restrict)
  sentBy          User?            @relation("InvitationsSent", fields: [sentByUserId], references: [id], onDelete: Restrict)

  @@index([companyId, status])
  @@index([recipientUserId, status])
  @@index([expiresAt, status])
}

model Session {
  id                String   @id @default(cuid())
  tokenHash         String   @unique
  userId            String
  rememberMe        Boolean  @default(false)
  createdAt         DateTime @default(now())
  lastSeenAt        DateTime @default(now())
  expiresAt         DateTime
  absoluteExpiresAt DateTime
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
}

model AuditEvent {
  id          String   @id @default(cuid())
  actorUserId String?
  eventType   String
  subjectType String?
  subjectId   String?
  metadata      Json?
  retentionHold Boolean  @default(false)
  createdAt     DateTime @default(now())
  actor         User?    @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([actorUserId, createdAt])
  @@index([eventType, createdAt])
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([expiresAt])
}

model RecoveryAttempt {
  id            String   @id @default(cuid())
  identifierKey String
  ipKey         String
  createdAt     DateTime @default(now())

  @@index([identifierKey, createdAt])
  @@index([ipKey, createdAt])
}


model RecoveryBlock {
  scopeKey    String   @id
  blockedUntil DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([blockedUntil])
}

model LoginAttempt {
  id            String   @id @default(cuid())
  identifierKey String
  ipKey         String
  succeeded     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([identifierKey, createdAt])
  @@index([ipKey, createdAt])
}

model LoginBlock {
  ipKey           String   @id
  blockedUntil    DateTime
  cooldownSeconds Int
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([blockedUntil])
}

model CompanyEmailVerificationToken {
  id        String   @id @default(cuid())
  companyId String
  tokenHash String   @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime @default(now())
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([expiresAt])
}

# PostgreSQL connection string. Never commit real credentials.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acessa_vagas?schema=public"

# Set to a long random value in each environment; never expose it to the browser.
SESSION_COOKIE_NAME="acessa_session"
APP_ENV="development"
# SMTP is required for account confirmation and password recovery emails.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Acessa Vagas <nao-responda@example.com>"
APP_BASE_URL="http://localhost:3000"

# Local PostgreSQL started with: docker compose up -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acessa_vagas?schema=public"

# Name of the HttpOnly session cookie; keep it consistent across application instances.
SESSION_COOKIE_NAME="acessa_session"
APP_ENV="development"

# Local Mailpit started with: docker compose up -d mailpit
# SMTP capture only: messages are visible at http://localhost:8025 and are not delivered externally.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Acessa Vagas <nao-responda@acessavagas.local>"
APP_BASE_URL="http://localhost:3000"

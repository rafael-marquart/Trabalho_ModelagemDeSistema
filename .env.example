# Local PostgreSQL started with: docker compose up -d postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/acessa_vagas?schema=public"

# Name of the HttpOnly session cookie; keep it consistent across application instances.
SESSION_COOKIE_NAME="acessa_session"
APP_ENV="development"

# Local Mailpit started with: docker compose up -d mailpit
# SMTP capture only: messages are visible at http://localhost:8025 and are not delivered externally.
SMTP_HOST="127.0.0.1"
SMTP_PORT="1025"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="Acessa Vagas <nao-responda@acessavagas.local>"
# STARTTLS is required by default for remote servers (port 587); set SMTP_SECURE="true" for port 465.
# Mailpit/local hosts run without TLS. See docs/operacao/email-smtp.md for real providers (Gmail, Brevo...).
SMTP_REQUIRE_TLS=""
# Optional: default recipient of "npm run email:test".
SMTP_TEST_TO=""
APP_BASE_URL="http://localhost:3000"

# SPEC-007: travel-time estimate (HERE free plan, OPEN-088). Create the key at https://platform.here.com (REST API key).
# Leave empty to run without it: trips on on-site/hybrid jobs then show "dados insuficientes". Never commit the real key.
HERE_API_KEY=""
# Safety cap: HERE requests stop at this share of the free monthly allowance and resume next month (default 60).
HERE_QUOTA_PERCENT="60"

# SPEC-017: e-mail notifications are sent right after each event and retried by a periodic round inside the server.
# NOTIFICATIONS_WORKER="off" disables both (only when another process delivers them); interval in milliseconds.
# On Vercel the periodic round does not run: retries come from /api/cron/notificacoes (docs/operacao/deploy-vercel.md).
NOTIFICATIONS_WORKER=""
NOTIFICATIONS_INTERVAL_MS="60000"

# Secret of the scheduled routes /api/cron/notificacoes and /api/cron/retencao (at least 16 characters).
# Empty locally: the routes refuse every call. In production, generate a long random value and never commit it.
CRON_SECRET=""

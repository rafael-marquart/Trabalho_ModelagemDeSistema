@startuml
skinparam shadowing false
skinparam defaultFontName DejaVu Sans
left to right direction
title UC-14 — Ingerir vagas externas (não implementado na main)
actor "Agendador" as AG
actor "Administrador" as A
actor "Adzuna" as Z
actor "LLM (opcional)" as L
rectangle "AcessaVagas (implementação futura)" {
  usecase "Coletar vagas externas" as C
  usecase "Validar e normalizar" as V
  usecase "Extrair dados com LLM" as X
  usecase "Deduplicar" as D
  usecase "Acompanhar execuções" as AC
}
AG -- C
A -- AC
C -- Z
C ..> V : <<include>>
C ..> D : <<include>>
X .> V : <<extend>>
X -- L
note bottom of C : Implementação futura (OPEN-102):\ncódigo só na branch desenvolvimento-do-projeto;\nfora da versão entregue.
@enduml
